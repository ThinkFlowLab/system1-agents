[0.0, "o", "$ bash evals/ticket_router/demo.sh\r\n"]
[0.097086958, "o", "# application/task   ticket routing: 30 labelled tickets, five queues\r\n"]
[0.097138333, "o", "# agents             s1a run ticket_router --model clm\r\n"]
[0.09713924999999998, "o", "# System1-Omni       omni-jev :8080  ->  clm-serve :8091  ->  Qwen3-8B on one RTX 4090\r\n"]
[0.09713966699999999, "o", "\r\n"]
[0.097203542, "o", "$ curl -s http://127.0.0.1:8080/health          # the frontend, ready, saying who is behind it\r\n"]
[0.22917812499999998, "o", "   {\"ok\": true, \"embedder\": true, \"models\": [\"clm-latest\", \"clm-raw\"]}\r\n"]
[0.22918924999999998, "o", "   vector cache on cuda\r\n"]
[0.23039675, "o", "\r\n"]
[0.23046341699999998, "o", "$ three of the thirty labelled tickets this run routes (seed 0 routes all of them)\r\n"]
[2.6535695419999996, "o", "   t_a5a229edd810  label=logistics Track the new order\r\n"]
[2.6535772079999997, "o", "      The duplicate charge on my previous order has been resolved. Today I only want the current l\r\n"]
[2.653581583, "o", "   t_c85ca34669b1  label=payment   Transaction status\r\n"]
[2.6535819999999997, "o", "      My bank shows a charge, but the order is still marked unpaid. Please verify whether this tra\r\n"]
[2.6535823749999996, "o", "   t_55ac1dd8d045  label=account   Forgotten password\r\n"]
[2.653582667, "o", "      I forgot my password and cannot log in. Please help me recover my account.\r\n"]
[2.6544188749999997, "o", "\r\n"]
[2.6544396669999997, "o", "$ CLM_URL=http://127.0.0.1:8080 s1a run ticket_router --model clm --rethink off \\\r\n"]
